# Copy to .env and adjust. Never commit real secrets.
PORT=4000
# Browser origin(s) allowed to call this API, comma-separated. Set to your Vercel URL in production.
FRONTEND_URL=http://localhost:8000
# Public URL of THIS backend, used to build absolute streamUrl values.
PUBLIC_BASE_URL=http://localhost:4000
MAX_ACTIVE_STREAMS=5
MAX_FILE_SIZE_GB=8
STREAM_EXPIRATION_MINUTES=60
TEMP_DIR=./data/torrents
# Optional: path to an ffmpeg binary. Docker sets /usr/bin/ffmpeg; locally the bundled binary is used.
FFMPEG_PATH=
# x264 speed preset for non-native containers (ultrafast..veryslow).
TRANSCODE_PRESET=veryfast
# How long to wait for torrent metadata before failing the request (seconds).
METADATA_TIMEOUT_SECONDS=90
LOG_LEVEL=info
